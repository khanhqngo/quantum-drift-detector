    "         n_timesteps=N_TS, n_shots=N_SH, true_cp=TRUE_CP,\n",
    "         meta=dict(shift_size=0.04, phi=0.0)),\n",
    "\n",
    "    dict(name='Depol-large',  noise_type='depolarizing',\n",
    "         sim_class=DepolarizingSimulator,\n",
    "         sim_kwargs=dict(error_rate_pre=0.01, error_rate_post=0.10, changepoint=TRUE_CP),\n",
    "         n_timesteps=N_TS, n_shots=N_SH, true_cp=TRUE_CP,\n",
    "         meta=dict(shift_size=0.09, phi=0.0)),\n",
    "\n",
    "    # ── Dephasing ──────────────────────────────────────────────────────────\n",
    "    dict(name='Deph-small',   noise_type='dephasing',\n",
    "         sim_class=DephasingSimulator,\n",
    "         sim_kwargs=dict(gamma_pre=0.1, gamma_post=0.3, changepoint=TRUE_CP),\n",
    "         n_timesteps=N_TS, n_shots=N_SH, true_cp=TRUE_CP,\n",
    "         meta=dict(shift_size=0.02, phi=0.0)),\n",
    "\n",
    "    dict(name='Deph-medium',  noise_type='dephasing',\n",
    "         sim_class=DephasingSimulator,\n",
    "         sim_kwargs=dict(gamma_pre=0.1, gamma_post=0.8, changepoint=TRUE_CP),\n",
    "         n_timesteps=N_TS, n_shots=N_SH, true_cp=TRUE_CP,\n",
    "         meta=dict(shift_size=0.07, phi=0.0)),\n",
    "\n",
    "    dict(name='Deph-large',   noise_type='dephasing',\n",
    "         sim_class=DephasingSimulator,\n",
    "         sim_kwargs=dict(gamma_pre=0.1, gamma_post=2.0, changepoint=TRUE_CP),\n",
    "         n_timesteps=N_TS, n_shots=N_SH, true_cp=TRUE_CP,\n",
    "         meta=dict(shift_size=0.19, phi=0.0)),\n",
    "\n",
    "    # ── Correlated AR(1), phi=0.7 ─────────────────────────────────────────\n",
    "    dict(name='Corr-small',   noise_type='correlated',\n",
    "         sim_class=CorrelatedNoiseSimulator,\n",
    "         sim_kwargs=dict(mu_pre=0.01, mu_post=0.03, phi=0.7, sigma=0.003,\n",
    "                         changepoint=TRUE_CP),\n",
    "         n_timesteps=N_TS, n_shots=N_SH, true_cp=TRUE_CP,\n",
    "         meta=dict(shift_size=0.02, phi=0.7)),\n",
    "\n",
    "    dict(name='Corr-medium',  noise_type='correlated',\n",
    "         sim_class=CorrelatedNoiseSimulator,\n",
    "         sim_kwargs=dict(mu_pre=0.01, mu_post=0.05, phi=0.7, sigma=0.003,\n",
    "                         changepoint=TRUE_CP),\n",
    "         n_timesteps=N_TS, n_shots=N_SH, true_cp=TRUE_CP,\n",
    "         meta=dict(shift_size=0.04, phi=0.7)),\n",
    "\n",
    "    dict(name='Corr-large',   noise_type='correlated',\n",
    "         sim_class=CorrelatedNoiseSimulator,\n",
    "         sim_kwargs=dict(mu_pre=0.01, mu_post=0.10, phi=0.7, sigma=0.003,\n",
